# Copy these into your shell, a run configuration, or a .env-loading tool
# before starting the Spring Boot app. Spring reads them as environment
# variables (see src/main/resources/application.properties).

# Local Windows Postgres (postgresql-x64-18 listens on 5434 in this setup):
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5434/sms_seals
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=postgres

# Hosted Postgres (Supabase, Neon, Railway, RDS, etc.) — use the JDBC form:
# SPRING_DATASOURCE_URL=jdbc:postgresql://host:5432/dbname
# SPRING_DATASOURCE_USERNAME=user
# SPRING_DATASOURCE_PASSWORD=password

# Port the API server listens on
PORT=4000
